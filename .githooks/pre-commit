#!/bin/sh

# Go lint
echo "Running Go lint..."
golangci-lint run ./...
if [ $? -ne 0 ]; then
  echo "Go lint failed. Fix errors before committing."
  exit 1
fi

# Frontend lint + format check
echo "Running frontend lint..."
cd frontend
npm run lint 2>/dev/null
if [ $? -ne 0 ]; then
  echo "Frontend lint failed. Fix errors before committing."
  exit 1
fi

npm run format:check 2>/dev/null
if [ $? -ne 0 ]; then
  echo "Frontend format check failed. Run 'npm run format' in frontend/."
  exit 1
fi
cd ..

echo "All checks passed."
